{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AppBuilder: ensure dependencies",
      "type": "shell",
      "command": "test -d node_modules || npm install",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "AppBuilder: build",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "AppBuilder: ensure dependencies",
      "problemMatcher": []
    }
  ]
}
