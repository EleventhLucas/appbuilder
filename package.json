{
  "name": "appbuilder",
  "productName": "AppBuilder",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop project runner and Codex client",
  "author": "EleventhLucas",
  "license": "Unlicense",
  "repository": "github:EleventhLucas/appbuilder",
  "main": "dist/main/main.js",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run clean && npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "npm run build && node --test tests/*.test.cjs && vitest run",
    "clean:artifacts": "node scripts/clean-artifacts.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "prepare:codex": "node scripts/prepare-codex.mjs",
    "package:win": "npm run generate:icons && npm run build && electron-builder --win nsis zip --x64",
    "package:linux": "npm run generate:icons && npm run build && electron-builder --linux AppImage deb --x64",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "smol-toml": "^1.7.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/merriweather": "^5.3.0",
    "@openai/codex": "0.145.0",
    "@playwright/test": "^1.61.1",
    "@shadcn/react": "^0.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.26.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.14.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
